# Server port (default 4000)
PORT=4000

# Path to clusters config (default ./clusters.json relative to server cwd)
CLUSTERS_CONFIG=./clusters.json

# Optional: override cluster URIs without editing clusters.json
# AKS_URI=mongodb://docdb:PASSWORD@localhost:27018/?tls=true&tlsAllowInvalidCertificates=true&authMechanism=SCRAM-SHA-256
# EKS_URI=mongodb://docdb:PASSWORD@localhost:27019/?tls=true&tlsAllowInvalidCertificates=true&authMechanism=SCRAM-SHA-256

# kubectl contexts (used by the failover orchestrator)
# AKS_KUBE_CONTEXT=azure-documentdb
# EKS_KUBE_CONTEXT=aws-documentdb
# HUB_KUBE_CONTEXT=hub

# DocumentDB CRD coordinates
# DOCUMENTDB_NAMESPACE=documentdb-preview-ns
# DOCUMENTDB_RESOURCE=documentdb-preview

# Initial primary (aks|eks). The poller will detect/correct this once clusters reply.
INITIAL_PRIMARY=aks

# Demo dataset target
DEMO_DB=demodb
DEMO_COLLECTION=failover_demo_events

# Log level (debug|info|warn|error)
LOG_LEVEL=info
