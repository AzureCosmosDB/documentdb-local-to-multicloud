{
  "name": "failover-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-cloud failover demo app for DocumentDB (Techorama Belgium 2026)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "npm-run-all -p dev:server dev:web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
